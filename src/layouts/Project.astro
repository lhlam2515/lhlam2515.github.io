---
import type { MarkdownHeading } from "astro";
import ImageSlot from "../components/ImageSlot.astro";
import PostItem from "../components/PostItem.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { caseStudyToc, decisionNumber, evidenceIds, hostLabel, repoLabel } from "../lib/case-study";
import { assertCaseStudyHeadings } from "../lib/checks";
import type { Project } from "../lib/content";
import { getPostsForProject } from "../lib/content";
import { SITE } from "../lib/site";
import Base from "./Base.astro";

/**
 * Case study (ADR-003, IA-007): hai phần ở cấp h2. "Tóm tắt" lấy từ frontmatter
 * (Vấn đề, Quyết định, Kết quả là h3); "Chi tiết" là thân Markdown, có heading
 * đã được hạ một cấp lúc render (src/lib/markdown-headings.ts): mục `##` thành
 * h3. Bốn phần của quyết định là chữ in đậm đầu đoạn, không phải heading.
 */
interface Props {
  project: Project;
  /** Heading của thân bài, từ render(); dựng mục lục và link từ thẻ quyết định. */
  headings: MarkdownHeading[];
}

const { project, headings } = Astro.props;
const { data } = project;
const posts = await getPostsForProject(project.id);
assertCaseStudyHeadings(project, headings);
// Mỗi quyết định có một mục cùng tên trong thân bài, nên thẻ quyết định và
// mục lục link thẳng xuống bằng chứng.
const evidenceId = evidenceIds(headings);
const toc = caseStudyToc(project, headings, posts.length > 0);
---

<Base title={`${data.title} · Dự án · ${SITE.name}`} description={data.summary}>
  <div class="container page case">
    <header class="case-header">
      <div class="page-intro">
        <a class="text-link" href="/projects/">← Mọi dự án</a>
        <p class="eyebrow">Case study</p>
        <h1>{data.title}</h1>
        <p class="lead case-lead">{data.summary}</p>
      </div>
      <dl class="facts">
        <div>
          <dt>Vai trò</dt>
          <dd>{data.role}</dd>
        </div>
        <div>
          <dt>Stack</dt>
          <dd>
            <ul class="stack">{data.stack.map((item) => <li>{item}</li>)}</ul>
          </dd>
        </div>
        {
          data.repoUrl && (
            <div>
              <dt>Mã nguồn</dt>
              <dd><a href={data.repoUrl}>{repoLabel(data.repoUrl)}</a></dd>
            </div>
          )
        }
        {
          data.liveUrl && (
            <div>
              <dt>Bản chạy</dt>
              <dd><a href={data.liveUrl}>{hostLabel(data.liveUrl)}</a></dd>
            </div>
          )
        }
      </dl>
    </header>

    <ImageSlot
      label={`Ảnh chụp ${data.title} trên desktop`}
      size="2400 × 1500"
      ratio="16 / 10"
      src={data.screenshot?.light}
      darkSrc={data.screenshot?.dark}
      frame
      loading="eager"
      sizes="(min-width: 1280px) 1200px, 100vw"
    />

    <div class="case-body">
      <TableOfContents parts={toc} title={data.title} />

      <div class="case-main">
        <section class="part" aria-labelledby="summary">
          <h2 id="summary" class="part-title">Tóm tắt</h2>

          <section class="narrow">
            <h3 id="problem">Vấn đề</h3>
            <p class="prose">{data.problem}</p>
          </section>

          <section class="decisions-section">
            <h3 id="decisions">Quyết định</h3>
            <!-- Tên quyết định ở đây là link, không phải heading: heading của nó
                 nằm ở phần Chi tiết, nên mỗi tên chỉ có một chỗ trong cây heading. -->
            <ol class="decisions">
              {
                data.decisions.map((decision, i) => {
                  const id = evidenceId.get(decision.title);
                  return (
                    <li>
                      <span class="num" aria-hidden="true">{decisionNumber(i)}</span>
                      <p class="decision-title">
                        {id ? <a class="evidence-link" href={`#${id}`}>{decision.title}</a> : decision.title}
                      </p>
                      <p>{decision.rationale}</p>
                    </li>
                  );
                })
              }
            </ol>
          </section>

          <section class="outcome">
            <h3 id="outcome">Kết quả</h3>
            <p class="prose">{data.outcome}</p>
          </section>
        </section>

        <section class="part" aria-labelledby="details">
          <h2 id="details" class="part-title">Chi tiết</h2>
          <div class="prose details">
            <slot />
          </div>
        </section>

        {
          posts.length > 0 && (
            <section class="related" aria-labelledby="rel">
              <h2 id="rel">Bài viết về dự án này</h2>
              <div class="posts">
                {posts.map((post) => (
                  <PostItem post={post} />
                ))}
              </div>
            </section>
          )
        }
      </div>
    </div>
  </div>
</Base>

<style>
  .case-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    container-type: inline-size;
  }

  .case-header .text-link {
    margin-bottom: calc(-1 * var(--space-sm));
  }

  /* eyebrow: chữ hoa, tracking 0.12em, màu link, chỉ đứng trên tiêu đề. */
  .eyebrow {
    font-family: var(--font-display);
    font-size: var(--fs-micro);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--link);
  }

  .case-lead {
    max-width: var(--measure);
  }

  /*
   * Thông tin (RD-005): số cột theo độ rộng của chính header, không theo
   * viewport. Một cột khi hẹp hơn 30rem, vì ở 2 cột mỗi ô chỉ còn khoảng 130 px
   * và URL phải ngắt giữa chữ; 2 cột từ 30rem; mọi mục một hàng từ 56rem.
   */
  .facts {
    display: grid;
    gap: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .facts > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;
  }

  .facts dt {
    font-size: var(--fs-caption);
    color: var(--fg-subtle);
  }

  .facts dd {
    font-size: var(--fs-body);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .facts .stack {
    font-size: var(--fs-caption);
    color: var(--fg);
  }

  .facts a {
    text-underline-offset: 3px;
  }

  @container (min-width: 30rem) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (min-width: 56rem) {
    .facts {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }
  }

  /* ---------- Thân trang: mục lục và nội dung ---------- */

  .case-body,
  .case-main {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  /* Hai phần cách nhau một bậc thang lớn hơn các mục trong phần. */
  .case-main {
    gap: var(--space-3xl);
    container-type: inline-size;
  }

  @media (min-width: 768px) {
    .case-main {
      gap: var(--space-4xl);
    }
  }

  /* ---------- Hai phần: Tóm tắt, Chi tiết ---------- */

  /*
   * h2 của phần lớn hơn h3 của mục và có vạch phía trên, để người đọc thấy mình
   * vừa sang phần khác. Tên phần gắn với nội dung của nó (space-lg) hơn là với
   * phần trước (khoảng cách giữa hai phần lớn hơn khoảng cách giữa các mục).
   */
  .part {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  .part-title {
    margin-bottom: calc(var(--space-lg) - var(--section-gap));
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-strong);
    font-size: var(--fs-h2);
  }

  .part > section > h3 {
    font-size: var(--fs-h4);
  }

  /* ---------- Nội dung ---------- */

  .narrow {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: var(--measure);
  }

  .decisions-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* Quyết định: một cột tới 40rem, 2 × 2 khi cột nội dung đủ cho hai thẻ khoảng 300 px. */
  .decisions {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .decisions li {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .num {
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    color: var(--link);
  }

  .decision-title {
    font-family: var(--font-display);
    font-size: var(--fs-h5);
    font-weight: 600;
    line-height: 1.3;
    color: var(--fg-strong);
  }

  /* Link xuống bằng chứng: gạch chân nhạt để thấy được là link cả khi không có hover. */
  .evidence-link {
    color: var(--fg-strong);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .evidence-link:hover {
    color: var(--link);
    text-decoration-color: currentColor;
  }

  .decisions p {
    line-height: 1.6;
    color: var(--fg-muted);
  }

  .outcome {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
  }

  .outcome .prose {
    max-width: var(--measure);
  }

  /*
   * Bốn phần của một quyết định là chữ in đậm đầu đoạn, không phải heading
   * (IA-007): cùng cỡ với chữ thường, chỉ khác độ đậm (`.prose strong`), nên
   * dưới mỗi mục h3 chỉ còn một cấp chữ.
   *
   * Mục `##` của thân bài (Bối cảnh, từng quyết định, Đối chiếu kết quả) render
   * thành h3, ngang cấp và cùng cỡ với Vấn đề / Quyết định / Kết quả, và với
   * mục h2 của bài viết (`.prose h2` trong global.css).
   */
  .details {
    max-width: var(--measure);
  }

  .details :global(h3) {
    margin-top: var(--section-gap);
    font-size: var(--fs-h4);
  }

  .details > :global(:first-child) {
    margin-top: 0;
  }

  .posts {
    display: grid;
    gap: var(--space-xl);
  }

  /* Dưới 30rem, padding 24 của thẻ và khung Kết quả làm cột chữ còn khoảng 240 px. */
  @container (min-width: 30rem) {
    .decisions li,
    .outcome {
      padding: var(--space-lg);
    }
  }

  @container (min-width: 40rem) {
    .decisions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .outcome {
      padding: var(--space-2xl);
    }

    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2xl);
    }
  }

  /*
   * Laptop: mục lục thành cột phải cố định trong màn hình, lấp khoảng 480 px
   * trống cạnh cột đọc 720.
   */
  @media (min-width: 1024px) {
    .page.case {
      padding-top: var(--space-2xl);
    }

    .case-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 17rem;
      column-gap: var(--space-3xl);
      align-items: start;
    }

    .case-main {
      grid-column: 1;
      grid-row: 1;
    }

    /* Mục lục nằm ở cột phải; kiểu cột và sticky là việc của TableOfContents. */
    .case-body > :global(.toc) {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
