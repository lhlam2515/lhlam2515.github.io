---
import RelatedProjectCard from "../components/RelatedProjectCard.astro";
import type { Post } from "../lib/content";
import { getPostTags, getProjectsByIds, getRelatedPosts, postUrl, tagUrl } from "../lib/content";
import { formatDate, isoDate } from "../lib/format";
import { SITE } from "../lib/site";
import Base from "./Base.astro";

/** Trang bài (IA-004): tiêu đề, ngày, tag, nội dung, dự án liên quan, bài liên quan. */
interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post;
const [tags, projects, related] = await Promise.all([
  getPostTags(post),
  getProjectsByIds((data.relatedProjects ?? []).map((p) => p.id)),
  getRelatedPosts(post),
]);
const tagLabel = new Map(tags.map((tag) => [tag.id, tag.data.label.vi]));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: data.title,
  description: data.description,
  datePublished: isoDate(data.pubDate),
  dateModified: isoDate(data.updatedDate ?? data.pubDate),
  inLanguage: "vi",
  url: new URL(postUrl(post), Astro.site).href,
  author: { "@type": "Person", name: SITE.author, url: new URL("/about/", Astro.site).href },
  keywords: tags.map((tag) => tag.data.label.vi).join(", "),
};
---

<Base title={`${data.title} · ${SITE.name}`} description={data.description} jsonLd={jsonLd} ogType="article">
  <div class="container-measure post-page">
    <article class="post">
      <a class="text-link" href="/blog/">← Mọi bài viết</a>
      <header class="post-header">
        <h1>{data.title}</h1>
        <div class="post-meta">
          <p class="meta">
            Đăng <time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time>
            {
              data.updatedDate && (
                <>
                  , cập nhật <time datetime={isoDate(data.updatedDate)}>{formatDate(data.updatedDate)}</time>
                </>
              )
            }
          </p>
          <ul class="tags" aria-label="Chủ đề">
            {tags.map((tag) => <li><a class="tag" href={tagUrl(tag)}>{tag.data.label.vi}</a></li>)}
          </ul>
        </div>
      </header>
      <p class="post-lead">{data.description}</p>
      <div class="prose">
        <slot />
      </div>
    </article>

    {
      projects.length > 0 && (
        <section class="related-projects" aria-labelledby="rel-project">
          <h2 id="rel-project" class="kicker">Bài này xuất phát từ dự án</h2>
          {projects.map((project) => <RelatedProjectCard project={project} />)}
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="related-posts" aria-labelledby="rel-posts">
          <h2 id="rel-posts">Bài liên quan</h2>
          <ul>
            {related.map(({ post: other, shared }) => (
              <li>
                <a class="title-link" href={postUrl(other)}>{other.data.title}</a>
                <span class="meta">
                  {formatDate(other.data.pubDate)}, {shared.map((id) => tagLabel.get(id)).join(", ")}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .post-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
    padding-block: var(--space-lg) var(--space-3xl);
  }

  .post {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .post-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Mobile: tag xuống dòng dưới ngày đăng (RD-005). */
  .post-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Chip trong dòng meta cao 28: ngoại lệ có chủ ý của RD-004 (đạt 24 của WCAG 2.5.8). */
  .tag {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 10px;
    border-radius: var(--radius-sm);
    background: var(--bg-muted);
    color: var(--fg-muted);
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
  }

  .tag:hover {
    background: var(--primary-tint);
    color: var(--fg);
  }

  .post-lead {
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--fg-muted);
  }

  .related-projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .kicker {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0;
    color: var(--fg-subtle);
  }

  .related-posts {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }

  .related-posts h2 {
    font-size: 1.25rem;
  }

  .related-posts ul {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-posts li {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .related-posts .title-link {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
  }

  @media (min-width: 768px) {
    .post-page {
      gap: 80px;
      padding-block: var(--space-2xl) var(--space-4xl);
    }

    .post-lead {
      font-size: 1.25rem;
    }

    .post-meta {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-md);
    }
  }
</style>
