---
import RelatedProjectCard from "../components/RelatedProjectCard.astro";
import type { Post } from "../lib/content";
import { getPostTags, getProjectsByIds, getRelatedPosts } from "../lib/content";
import { formatDate, isoDate } from "../lib/format";
import { SITE } from "../lib/site";
import { blogPostingJsonLd } from "../lib/structured-data";
import { postUrl, tagUrl } from "../lib/urls";
import Base from "./Base.astro";

/** Trang bài (IA-004): tiêu đề, ngày, tag, nội dung, dự án liên quan, bài liên quan. */
interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post;
const [tags, projects, related] = await Promise.all([
  getPostTags(post),
  getProjectsByIds((data.relatedProjects ?? []).map((p) => p.id)),
  getRelatedPosts(post),
]);
const tagLabel = new Map(tags.map((tag) => [tag.id, tag.data.label.vi]));

const jsonLd = blogPostingJsonLd(post, tags, Astro.site);
---

<Base title={`${data.title} · ${SITE.name}`} description={data.description} jsonLd={jsonLd} ogType="article">
  <div class="container-measure post-page">
    <article class="post">
      <!-- Cùng thứ tự với đầu trang case study: tiêu đề, dẫn, rồi thông tin dưới
           một vạch, để dẫn đọc như tóm tắt của bài chứ không như đoạn đầu thân bài. -->
      <header class="post-header">
        <div class="page-intro">
          <a class="text-link" href="/blog/">← Mọi bài viết</a>
          <h1>{data.title}</h1>
          <p class="lead post-lead">{data.description}</p>
        </div>
        <div class="post-meta">
          <p class="meta">
            Đăng <time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time>
            {
              data.updatedDate && (
                <>
                  , cập nhật <time datetime={isoDate(data.updatedDate)}>{formatDate(data.updatedDate)}</time>
                </>
              )
            }
          </p>
          <ul class="tags" aria-label="Chủ đề">
            {tags.map((tag) => <li><a class="tag" href={tagUrl(tag)}>{tag.data.label.vi}</a></li>)}
          </ul>
        </div>
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>

    {
      projects.length > 0 && (
        <section class="related" aria-labelledby="rel-project">
          <h2 id="rel-project">Bài này xuất phát từ dự án</h2>
          {projects.map((project) => <RelatedProjectCard project={project} />)}
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="related related-posts" aria-labelledby="rel-posts">
          <h2 id="rel-posts">Bài liên quan</h2>
          <ul>
            {related.map(({ post: other, shared }) => (
              <li>
                <a class="title-link" href={postUrl(other)}>{other.data.title}</a>
                <span class="meta">
                  {formatDate(other.data.pubDate)}, {shared.map((id) => tagLabel.get(id)).join(", ")}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .post-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
    padding-block: var(--space-lg) var(--space-3xl);
  }

  /* Khoảng từ đầu trang xuống thân bài lớn hơn khoảng giữa các khối trong đầu
     trang, để đầu trang đọc thành một khối. */
  .post {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .post-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* Như `.facts` của case study: vạch nhạt tách thông tin khỏi tiêu đề và dẫn.
     Mobile: tag xuống dòng dưới ngày đăng (RD-005). */
  .post-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Chip trong dòng meta cao 28: ngoại lệ có chủ ý của RD-004 (đạt 24 của WCAG 2.5.8). */
  .tag {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 var(--space-sm);
    border-radius: var(--radius-sm);
    background: var(--bg-muted);
    color: var(--fg-muted);
    font-size: var(--fs-micro);
    font-weight: 500;
    text-decoration: none;
  }

  .tag:hover {
    background: var(--primary-tint);
    color: var(--fg);
  }

  .post-lead {
    max-width: var(--measure);
  }

  .related-posts ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-posts li {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .related-posts .title-link {
    font-family: var(--font-display);
    font-size: var(--fs-body-lg);
    font-weight: 600;
    line-height: 1.35;
  }

  @media (min-width: 768px) {
    .post-page {
      gap: var(--space-4xl);
      padding-block: var(--space-2xl) var(--space-4xl);
    }

    .post-meta {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
  }
</style>
