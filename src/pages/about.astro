---
import ButtonLink from "../components/ButtonLink.astro";
import portrait from "../assets/portrait.jpg";
import ImageSlot from "../components/ImageSlot.astro";
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { getAboutPage, getHomePage } from "../lib/content";
import { CONTACT, SITE } from "../lib/site";

// IA-008: chữ của trang nằm ở src/content/pages/vi/about.md; câu định vị ở home.md.
const [about, home] = await Promise.all([getAboutPage(), getHomePage()]);
const { lead, principles, education } = about.data;
const { Content } = await render(about);

const channels = [
  { label: "GitHub", value: CONTACT.github.handle, href: CONTACT.github.url },
  { label: "LinkedIn", value: CONTACT.linkedin.handle, href: CONTACT.linkedin.url },
  { label: "RSS", value: CONTACT.rss, href: CONTACT.rss },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.author,
  alternateName: SITE.name,
  jobTitle: SITE.jobTitle,
  url: new URL("/about/", Astro.site).href,
  address: { "@type": "PostalAddress", addressLocality: "Thành phố Hồ Chí Minh", addressCountry: "VN" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "Trường Đại học Khoa học Tự nhiên, ĐHQG-HCM" },
  sameAs: [CONTACT.github.url, CONTACT.linkedin.url],
};
---

<Base title={`Giới thiệu · ${SITE.name}`} description={home.data.description} jsonLd={jsonLd}>
  <!--
    Thứ tự HTML là thứ tự đọc trên mobile: tiêu đề, ảnh, kênh liên hệ, rồi nội
    dung. Trên laptop grid đặt <aside> vào cột trái 400 bằng grid-column
    (responsive.md, RD-005), không dùng order.
  -->
  <div class="container page about">
    <div class="page-intro intro">
      <h1>Giới thiệu</h1>
      <p class="lead">{lead}</p>
    </div>

    <aside aria-label="Liên hệ">
      <ImageSlot
        label="Ảnh chân dung"
        size="880 × 1100"
        ratio="4 / 5"
        mobileRatio="4 / 3"
        src={portrait}
        alt={`Ảnh chân dung ${SITE.author}`}
        position="50% 20%"
        loading="eager"
        sizes="(min-width: 1024px) 400px, (min-width: 768px) 240px, 100vw"
      />
      <div class="channels">
        <ButtonLink href={`mailto:${CONTACT.email}`}>Email</ButtonLink>
        <ul>
          {
            channels.map((c) => (
              <li>
                <a href={c.href}>
                  <span>{c.label}</span>
                  <span class="handle">{c.value}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>

    <div class="content">
      <section aria-labelledby="what">
        <h2 id="what">Tôi làm gì</h2>
        <div class="prose">
          <Content />
        </div>
      </section>

      <section aria-labelledby="how">
        <h2 id="how">Cách tôi làm việc</h2>
        <ul class="principles">
          {
            principles.map((p) => (
              <li>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      {
        education.length > 0 && (
          <section aria-labelledby="edu">
            <h2 id="edu">Học vấn</h2>
            <dl class="education">
              {education.map((e) => (
                <div>
                  <dt class="meta">{e.period}</dt>
                  <dd>
                    <span class="entry-title">{e.title}</span>
                    <p>{e.text}</p>
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }
    </div>
  </div>
</Base>

<style>
  .page.about {
    display: grid;
    gap: var(--space-xl);
  }

  aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .channels ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .channels li + li {
    border-top: 1px solid var(--border);
  }

  .channels a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: var(--touch-target);
    font-size: var(--fs-caption);
    font-weight: 500;
    text-decoration: none;
  }

  .handle {
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    color: var(--fg-subtle);
    overflow-wrap: anywhere;
    text-align: right;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    min-width: 0;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 640px;
  }

  section h2 {
    font-size: var(--fs-h4);
  }

  .principles {
    display: grid;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principles li {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .principles h3 {
    font-size: var(--fs-body-lg);
  }

  .principles p,
  .education p {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--fg-muted);
  }

  .education {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .education > div {
    display: grid;
    gap: var(--space-xs);
  }

  .entry-title {
    font-family: var(--font-display);
    font-size: var(--fs-body-lg);
    font-weight: 600;
    color: var(--fg-strong);
  }

  /* Tablet: ảnh 240 cạnh kênh liên hệ. */
  @media (min-width: 768px) {
    aside {
      display: grid;
      grid-template-columns: 240px minmax(0, 1fr);
      align-items: start;
    }

    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .education > div {
      grid-template-columns: 160px minmax(0, 1fr);
      gap: var(--space-lg);
    }
  }

  /* Laptop: ảnh và kênh liên hệ ở cột trái 400. */
  @media (min-width: 1024px) {
    .page.about {
      grid-template-columns: 400px minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: var(--space-4xl);
      row-gap: var(--space-3xl);
      align-items: start;
    }

    .intro,
    .content {
      grid-column: 2;
    }

    aside {
      grid-column: 1;
      grid-row: 1 / -1;
      display: flex;
      align-items: stretch;
    }

    .content {
      gap: var(--space-3xl);
    }

    section {
      max-width: none;
    }
  }
</style>
