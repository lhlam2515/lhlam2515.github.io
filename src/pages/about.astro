---
import BookOpen from "@phosphor-icons/core/regular/book-open-text.svg";
import DownloadSimple from "@phosphor-icons/core/regular/download-simple.svg";
import Envelope from "@phosphor-icons/core/regular/envelope-simple.svg";
import Folder from "@phosphor-icons/core/regular/folder-simple.svg";
import GitCommit from "@phosphor-icons/core/regular/git-commit.svg";
import GithubLogo from "@phosphor-icons/core/regular/github-logo.svg";
import GraduationCap from "@phosphor-icons/core/regular/graduation-cap.svg";
import LinkedinLogo from "@phosphor-icons/core/regular/linkedin-logo.svg";
import MapPin from "@phosphor-icons/core/regular/map-pin.svg";
import Rss from "@phosphor-icons/core/regular/rss.svg";
import { render } from "astro:content";
import { existsSync } from "node:fs";
import { join } from "node:path";
import portrait from "../assets/portrait.jpg";
import ButtonLink from "../components/ButtonLink.astro";
import ImageSlot from "../components/ImageSlot.astro";
import Base from "../layouts/Base.astro";
import { getAboutPage, getFeaturedProjects, getHomePage } from "../lib/content";
import { CONTACT, SITE } from "../lib/site";
import { slugify } from "../lib/slug";
import { projectUrl } from "../lib/urls";

// IA-008: chữ của trang nằm ở src/content/pages/vi/about.md; câu định vị ở home.md.
const [about, home, projects] = await Promise.all([getAboutPage(), getHomePage(), getFeaturedProjects()]);
const { lead, principles, education } = about.data;
const { Content } = await render(about);

// CV chưa có file thì nút vô hiệu kèm dòng giải thích; bỏ file vào public/ là
// nút tự bật lúc build, không phải sửa code.
const hasCv = existsSync(join(process.cwd(), "public", SITE.cv));

const links = [
  { label: "GitHub", value: CONTACT.github.handle, href: CONTACT.github.url, Icon: GithubLogo },
  { label: "LinkedIn", value: CONTACT.linkedin.handle, href: CONTACT.linkedin.url, Icon: LinkedinLogo },
  { label: "RSS", value: CONTACT.rss, href: CONTACT.rss, Icon: Rss },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.author,
  alternateName: SITE.name,
  jobTitle: SITE.jobTitle,
  url: new URL("/about/", Astro.site).href,
  address: { "@type": "PostalAddress", addressLocality: "Thành phố Hồ Chí Minh", addressCountry: "VN" },
  alumniOf: { "@type": "CollegeOrUniversity", name: SITE.school },
  sameAs: [CONTACT.github.url, CONTACT.linkedin.url],
};
---

<Base title={`Giới thiệu · ${SITE.name}`} description={home.data.description} jsonLd={jsonLd}>
  <!--
    Bố cục hồ sơ GitHub (RD-005). Thứ tự HTML là thứ tự đọc trên mobile: hồ sơ,
    tiêu đề và chữ dẫn, rồi nội dung. Từ 768 grid đặt hồ sơ vào cột trái bằng
    grid-column, không dùng order. Thứ tự nội dung: "Tôi làm gì", dự án, cách
    làm việc, học vấn.
  -->
  <div class="container page about">
    <div class="profile">
      <ImageSlot
        class="avatar"
        label="Ảnh chân dung"
        size="880 × 880"
        ratio="1 / 1"
        src={portrait}
        alt={`Ảnh chân dung ${SITE.author}`}
        position="50% 20%"
        loading="eager"
        sizes="(min-width: 1024px) 296px, (min-width: 768px) 240px, 96px"
      />
      <div class="identity">
        <p class="name">{SITE.author}</p>
        <p class="job">{SITE.jobTitle}</p>
      </div>

      <div class="cv">
        <ButtonLink
          href={hasCv ? SITE.cv : undefined}
          download={hasCv ? `cv-${slugify(SITE.author)}.pdf` : undefined}
          describedby={hasCv ? undefined : "cv-note"}
        >
          <DownloadSimple aria-hidden="true" />
          Tải CV
        </ButtonLink>
        {!hasCv && <p id="cv-note">CV đang được cập nhật.</p>}
      </div>

      <ul class="facts" aria-label="Thông tin và liên hệ">
        <li><MapPin aria-hidden="true" /><span>{SITE.location}</span></li>
        <li><GraduationCap aria-hidden="true" /><span>{SITE.school}</span></li>
        <li>
          <Envelope aria-hidden="true" />
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </li>
        {
          links.map(({ label, value, href, Icon }) => (
            <li>
              <Icon aria-hidden="true" />
              <a href={href} aria-label={`${label}: ${value}`}>{value}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="page-intro intro">
      <h1>Giới thiệu</h1>
      <p class="lead">{lead}</p>
    </div>

    <div class="content">
      <section class="readme" aria-labelledby="what">
        <div class="readme-head">
          <BookOpen aria-hidden="true" />
          <h2 id="what">Tôi làm gì</h2>
        </div>
        <div class="readme-body prose">
          <Content />
        </div>
      </section>

      {
        projects.length > 0 && (
          <section aria-labelledby="pinned">
            <div class="section-head">
              <h2 id="pinned">Dự án tiêu biểu</h2>
              <a href="/projects/">Mọi dự án</a>
            </div>
            <ul class="pinned">
              {projects.map((p) => (
                <li>
                  <div class="pin-title">
                    <Folder aria-hidden="true" />
                    <h3><a href={projectUrl(p)}>{p.data.title}</a></h3>
                  </div>
                  <p>{p.data.summary}</p>
                  <ul class="stack" aria-label="Công nghệ">
                    {p.data.stack.slice(0, 4).map((item) => <li>{item}</li>)}
                  </ul>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section aria-labelledby="how">
        <h2 id="how">Cách tôi làm việc</h2>
        <ul class="principles">
          {
            principles.map((p) => (
              <li>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      {
        education.length > 0 && (
          <section aria-labelledby="edu">
            <h2 id="edu">Học vấn</h2>
            {/* <ol>: các mốc có thứ tự thời gian. Nút commit chỉ trang trí nên ẩn khỏi trình đọc màn hình. */}
            <ol class="timeline">
              {education.map((e) => (
                <li>
                  <span class="node" aria-hidden="true">
                    <GitCommit />
                  </span>
                  <h3>{e.title}</h3>
                  <p class="period">{e.period}</p>
                  <p>{e.text}</p>
                </li>
              ))}
            </ol>
          </section>
        )
      }
    </div>
  </div>
</Base>

<style>
  .page.about {
    display: grid;
    gap: var(--space-2xl);
  }

  /* `.lead` chung giới hạn 640 cho cột chữ hẹp; ở đây chữ dẫn nằm trong cột nội
     dung đã có giới hạn riêng, nên hiện hết chiều ngang cột như khung bên dưới. */
  .intro .lead {
    max-width: none;
  }

  /* ---------- Hồ sơ ---------- */

  /* Mobile: ảnh 96 cạnh tên như ứng dụng GitHub, để nội dung lên sớm. */
  .profile {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    align-items: center;
    gap: var(--space-lg) var(--space-md);
  }

  .cv,
  .facts {
    grid-column: 1 / -1;
  }

  .cv {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .cv svg {
    flex: none;
    width: 1.25em;
    height: 1.25em;
  }

  #cv-note {
    font-size: var(--fs-caption);
    color: var(--fg-subtle);
    text-align: center;
  }

  .profile :global(.avatar) {
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--border);
  }

  .identity {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: 600;
    line-height: 1.25;
    color: var(--fg-strong);
  }

  .job {
    font-size: var(--fs-body-lg);
    color: var(--fg-subtle);
  }

  /* Khối liên hệ là thứ người đến từ CV tìm, nên dùng cỡ chữ body chứ không
     phải caption. Mỗi dòng cao 32 để danh sách gọn: dưới mức 44 của RD-004 nhưng
     vẫn trên mức 24 của WCAG 2.5.8, như chip tag. */
  .facts {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-body);
    color: var(--fg-muted);
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 32px;
  }

  .facts svg {
    flex: none;
    width: 1.25em;
    height: 1.25em;
    color: var(--fg-subtle);
  }

  .facts a {
    display: flex;
    align-items: center;
    min-height: 32px;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .facts a:hover {
    text-decoration: underline;
  }

  /* ---------- Nội dung ---------- */

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    min-width: 0;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  section h2 {
    font-size: var(--fs-h4);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .section-head a {
    font-size: var(--fs-caption);
    font-weight: 500;
  }

  /* README: khung có thanh tiêu đề như file README trên hồ sơ GitHub. */
  .readme {
    gap: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .readme-head {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
    border-bottom: 1px solid var(--border);
    color: var(--fg-subtle);
  }

  .readme-head svg {
    flex: none;
    width: 1.25em;
    height: 1.25em;
  }

  /* Vẫn là h2 (mục cùng cấp với các mục khác) nhưng hiện ở cỡ h3 như
     `.prose h3`: thanh tiêu đề của khung chỉ là nhãn, không phải điểm nhấn. */
  .readme-head h2 {
    font-size: var(--fs-h5);
  }

  .readme-body {
    padding: var(--space-lg) var(--space-md);
  }


  /* Dự án ghim: một thẻ thì toàn chiều ngang, nhiều thẻ thì chia cột khi đủ chỗ. */
  .pinned {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pinned > li {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .pin-title {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .pin-title svg {
    flex: none;
    width: 1.25em;
    height: 1.25em;
    margin-top: 0.125em;
    color: var(--fg-subtle);
  }

  .pin-title h3 {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 600;
  }

  .pin-title a {
    text-decoration: none;
  }

  .pin-title a:hover {
    text-decoration: underline;
  }

  .pinned p,
  .principles p,
  .timeline p {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--fg-muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: auto 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-caption);
    color: var(--fg-subtle);
  }

  /* Dòng thời gian như "Contribution activity": vạch dọc nối các nút commit. */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Vạch nối từ dưới nút này tới nút kế tiếp, nên không thò ra sau mốc cuối. */
  .timeline > li:not(:last-child)::before {
    content: "";
    position: absolute;
    top: var(--space-xl);
    bottom: calc(-1 * var(--space-lg));
    left: calc(var(--space-xl) / 2);
    border-left: 1px solid var(--border-strong);
  }

  .timeline > li {
    position: relative;
    display: grid;
    grid-template-columns: var(--space-xl) minmax(0, 1fr);
    column-gap: var(--space-md);
    row-gap: var(--space-xs);
  }

  .node {
    grid-row: 1 / 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--space-xl);
    height: var(--space-xl);
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--bg-subtle);
    color: var(--fg-subtle);
  }

  .node svg {
    width: 1.25em;
    height: 1.25em;
  }

  .timeline h3 {
    align-self: center;
    font-family: var(--font-display);
    font-size: var(--fs-body-lg);
    font-weight: 600;
    line-height: 1.4;
    color: var(--fg-strong);
  }

  .timeline li > :not(.node) {
    grid-column: 2;
  }

  /* Cụ thể hơn `.timeline p` để giữ cỡ chữ mono. */
  .timeline .period {
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    color: var(--fg-subtle);
  }

  .principles {
    display: grid;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principles li {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .principles h3 {
    font-size: var(--fs-body-lg);
  }

  /* Tablet: hồ sơ thành cột trái 240, ảnh chiếm hết chiều ngang cột. */
  @media (min-width: 768px) {
    .page.about {
      grid-template-columns: 240px minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: var(--space-xl);
      align-items: start;
    }

    /* Hồ sơ đứng trước trong HTML nên đặt hàng tường minh cho cột phải. */
    .intro {
      grid-column: 2;
      grid-row: 1;
    }

    .content {
      grid-column: 2;
      grid-row: 2;
    }

    .profile {
      grid-column: 1;
      grid-row: 1 / -1;
      grid-template-columns: minmax(0, 1fr);
      align-items: stretch;
    }

    /* Chữ trong thanh tiêu đề thẳng mép với thân khung. */
    .readme-head {
      padding: var(--space-md) var(--space-xl);
    }

    .readme-body {
      padding: var(--space-xl);
    }
  }

  /* Laptop: cột hồ sơ 296 như GitHub, nguyên tắc chia 2 cột. */
  @media (min-width: 1024px) {
    .page.about {
      grid-template-columns: 296px minmax(0, 1fr);
      column-gap: var(--space-2xl);
    }

    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
