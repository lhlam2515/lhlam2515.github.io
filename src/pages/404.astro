---
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site";

// IA-001: không có redirect phía server, nên đây là đường cứu hộ duy nhất.
const routes = [
  { label: "Blog", href: "/blog/" },
  { label: "Dự án", href: "/projects/" },
  { label: "Chủ đề", href: "/tags/" },
];
---

<Base title={`Không tìm thấy trang · ${SITE.name}`} description="Đường dẫn này không tồn tại trên SoJDev.">
  <div class="container page not-found">
    <div class="page-intro">
      <p class="code">404</p>
      <h1>Không tìm thấy trang này</h1>
      <p class="lead">Đường dẫn có thể đã gõ sai, hoặc trang chưa từng tồn tại.</p>
      <a class="text-link" href="/">Về trang chủ →</a>
    </div>
    <nav aria-label="Tìm tiếp">
      <ul>
        {
          routes.map((r) => (
            <li>
              <a href={r.href}>
                <span class="label">{r.label}</span>
                <span class="path">{r.href}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Base>

<style>
  .code {
    align-self: flex-start;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    background: var(--bg-muted);
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--fg-muted);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  li {
    border-bottom: 1px solid var(--border);
  }

  nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 64px;
    padding: 0 12px;
    text-decoration: none;
  }

  nav a:hover {
    background: var(--bg-subtle);
  }

  .label {
    font-family: var(--font-display);
    font-size: var(--fs-post-title);
    font-weight: 600;
    color: var(--fg-strong);
  }

  .path {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg-subtle);
  }

  @media (min-width: 1024px) {
    .page.not-found {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 480px;
      gap: 80px;
      align-items: center;
      padding-block: var(--space-4xl);
    }
  }
</style>
