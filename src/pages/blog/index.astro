---
import PostYearList from "../../components/PostYearList.astro";
import TopicNav from "../../components/TopicNav.astro";
import Base from "../../layouts/Base.astro";
import { getFeaturedTopics, getPublishedPosts } from "../../lib/content";
import { SITE } from "../../lib/site";

// IA-005: mọi bài trên một trang, nhóm theo năm, không phân trang, không lọc JS.
const [posts, topics] = await Promise.all([getPublishedPosts(), getFeaturedTopics()]);
const lead = "Bài viết kỹ thuật về kiến trúc web, kỹ thuật yêu cầu, kiểm thử và AI agent.";
---

<Base title={`Blog · ${SITE.name}`} description={lead}>
  <div class="container page blog">
    <div class="page-intro">
      <h1>Blog</h1>
      <p class="lead">{lead}</p>
    </div>
    <TopicNav topics={topics}>
      <li><a class="text-link" href="/tags/">Mọi chủ đề →</a></li>
    </TopicNav>
    <PostYearList posts={posts} />
  </div>
</Base>

<style>
  .page.blog {
    gap: var(--space-2xl);
  }

  .text-link {
    padding: 0 var(--space-sm);
  }
</style>
