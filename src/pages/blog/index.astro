---
import PostYearList from "../../components/PostYearList.astro";
import StatIntro from "../../components/StatIntro.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import TopicNav from "../../components/TopicNav.astro";
import Base from "../../layouts/Base.astro";
import { archiveToc } from "../../lib/archive";
import { getFeaturedTopics, getPublishedPosts } from "../../lib/content";
import { getBlogOverview } from "../../lib/overview";
import { SITE } from "../../lib/site";

// IA-005: mọi bài trên một trang, nhóm theo năm, không phân trang, không lọc JS.
const [posts, topics] = await Promise.all([getPublishedPosts(), getFeaturedTopics()]);
const overview = await getBlogOverview(posts);
// Không hiện trên trang, chỉ làm meta description: đầu trang là số liệu, như /projects/.
const description = "Bài viết kỹ thuật về kiến trúc web, kỹ thuật yêu cầu, kiểm thử và AI agent.";
// Mục lục năm → tháng kèm số bài: cột phải dính theo khi cuộn ở laptop, nút
// nổi dưới 1024 (TableOfContents, RD-004).
const toc = archiveToc(posts);
---

<Base title={`Blog · ${SITE.name}`} description={description}>
  <div class="container page blog">
    <StatIntro stats={overview.stats}>
      <h1 slot="title">Blog</h1>
      <div class="topics">
        <p class="topics-label" aria-hidden="true">Chủ đề nổi bật</p>
        <TopicNav topics={topics} counts={overview.tagCounts}>
          <li><a class="text-link" href="/tags/">Mọi chủ đề →</a></li>
        </TopicNav>
      </div>
    </StatIntro>
    <div class="blog-body">
      <TableOfContents parts={toc} label="Theo thời gian" />
      <PostYearList posts={posts} byMonth openLimit={10} />
    </div>
  </div>
</Base>

<style>
  .page.blog {
    gap: var(--space-2xl);
  }

  .topics {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* Nhãn nhìn thấy của nav; trình đọc màn hình đã có aria-label của TopicNav. */
  .topics-label {
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--fg-subtle);
  }

  .text-link {
    padding: 0 var(--space-sm);
  }

  /* Laptop: mục lục là cột phải 17rem như case study (Project.astro). */
  @media (min-width: 1024px) {
    .blog-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 17rem;
      column-gap: var(--space-3xl);
      align-items: start;
    }

    .blog-body > :global(.years) {
      grid-column: 1;
      grid-row: 1;
    }

    .blog-body > :global(.toc) {
      grid-column: 2;
      grid-row: 1;
    }

    /* Mục lục đã có năm, nên cột năm giữ 120 như tablet để cột bài không
       hẹp dưới 480 ở 1024. */
    .blog-body :global(.year) {
      grid-template-columns: 120px minmax(0, 1fr);
      gap: var(--space-lg);
    }
  }
</style>
