---
import PostYearList from "../../components/PostYearList.astro";
import Base from "../../layouts/Base.astro";
import { getPublishedPosts, getTagsWithCounts, type Tag } from "../../lib/content";
import { SITE } from "../../lib/site";

// IA-002: trang chỉ sinh ra khi tag có ít nhất một bài đã đăng.
export async function getStaticPaths() {
  const [tags, posts] = await Promise.all([getTagsWithCounts(), getPublishedPosts()]);
  return tags.map(({ tag }) => ({
    params: { tag: tag.id },
    props: { tag, posts: posts.filter((post) => post.data.tags.some(({ id }) => id === tag.id)) },
  }));
}

const { tag, posts } = Astro.props as { tag: Tag; posts: Awaited<ReturnType<typeof getPublishedPosts>> };
const { label, description } = tag.data;
---

<Base title={`${label.vi} · ${SITE.name}`} description={description}>
  <div class="container page tag-page">
    <div class="page-intro">
      <a class="text-link" href="/tags/">← Mọi chủ đề</a>
      <h1>{label.vi}</h1>
      <p class="lead">{description} {posts.length} bài.</p>
    </div>
    <PostYearList posts={posts} />
  </div>
</Base>

<style>
  .page.tag-page {
    gap: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .page.tag-page {
      padding-top: var(--space-2xl);
    }
  }
</style>
