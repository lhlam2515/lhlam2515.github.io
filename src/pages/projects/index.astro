---
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectFeature from "../../components/ProjectFeature.astro";
import Base from "../../layouts/Base.astro";
import { getProjects } from "../../lib/content";
import { SITE } from "../../lib/site";

// IA-005: featured trước, sau đó theo `order`. Dự án featured có ảnh và nhãn
// các quyết định, so le trái/phải trên laptop; dự án còn lại là thẻ chữ.
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
const lead = "Mỗi case study trình bày vấn đề, quyết định và kết quả, thay vì danh sách tính năng.";
---

<Base title={`Dự án · ${SITE.name}`} description={lead}>
  <div class="container page">
    <div class="page-intro">
      <h1>Dự án</h1>
      <p class="lead">{lead}</p>
    </div>

    {featured.map((project, i) => <ProjectFeature project={project} summary="role" headingLevel="h2" reverse={i % 2 === 1} />)}

    {
      others.length > 0 && (
        <section class="others" aria-labelledby="more">
          <h2 id="more">Dự án khác</h2>
          <div class="grid-2">
            {others.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .others {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .others h2 {
    font-size: var(--fs-h4);
  }

  .grid-2 {
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .grid-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2xl);
    }
  }
</style>
