---
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectFeature from "../../components/ProjectFeature.astro";
import StatIntro from "../../components/StatIntro.astro";
import Base from "../../layouts/Base.astro";
import { getProjects } from "../../lib/content";
import { getProjectsOverview } from "../../lib/overview";
import { SITE } from "../../lib/site";

// IA-005: featured trước, sau đó theo `order`. Dự án featured có ảnh và nhãn
// các quyết định, so le trái/phải trên laptop; dự án còn lại là thẻ chữ.
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
const overview = await getProjectsOverview(projects);
// Không hiện trên trang, chỉ làm meta description: đầu trang là số liệu.
const description =
  "Mỗi case study trình bày vấn đề, quyết định và kết quả, thay vì danh sách tính năng.";
---

<Base title={`Dự án · ${SITE.name}`} description={description}>
  <div class="container page">
    <StatIntro stats={overview.stats}>
      <h1 slot="title">Dự án</h1>
      <div class="tech">
        <p class="tech-label" id="tech-label">Công nghệ</p>
        <ul class="tags" aria-labelledby="tech-label">
          {
            overview.stack.map(({ name, count }) => (
              <li class="tag">
                {name}
                {count > 1 && (
                  <span class="count">
                    <span aria-hidden="true">×{count}</span>
                    <span class="visually-hidden">
                      , dùng ở {count} dự án
                    </span>
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </StatIntro>

    {
      featured.map((project, i) => (
        <ProjectFeature
          project={project}
          summary="role"
          headingLevel="h2"
          reverse={i % 2 === 1}
        />
      ))
    }

    {
      others.length > 0 && (
        <section class="others" aria-labelledby="more">
          <h2 id="more">Dự án khác</h2>
          <div class="grid-2">
            {others.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .tech {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .tech-label {
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--fg-subtle);
  }

  /* Tag của design system: chip viền 28, không bấm được nên không cần vùng chạm 44. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 var(--space-sm);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--fg);
    font-size: var(--fs-micro);
    font-weight: 500;
  }

  .count {
    margin-left: var(--space-xs);
    color: var(--link);
    font-weight: 600;
  }

  .others {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .others h2 {
    font-size: var(--fs-h4);
  }

  .grid-2 {
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .grid-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2xl);
    }
  }
</style>
