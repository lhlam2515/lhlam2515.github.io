---
import { render } from "astro:content";
import Project from "../../layouts/Project.astro";
import { getProjects, type Project as ProjectEntry } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: ProjectEntry };
const { Content, headings } = await render(project);
---

<Project project={project} headings={headings}>
  <Content />
</Project>
