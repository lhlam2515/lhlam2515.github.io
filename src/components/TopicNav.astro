---
import type { Tag } from "../lib/content";
import { tagUrl } from "../lib/urls";

/**
 * Nút lọc chủ đề (IA-002, IA-005): link tới /tags/<tag>/, không lọc bằng JS.
 * Xuống dòng khi hết chỗ, không cuộn ngang để không giấu chủ đề (RD-005).
 *
 * `layout="column"`: trên trang chủ từ 1024, danh sách dọc trong cột 320.
 */
interface Props {
  topics: Tag[];
  label?: string;
  layout?: "row" | "column";
  /** Số bài theo id tag; có thì chip kèm số, như Tag của /projects/. */
  counts?: Map<string, number>;
}

const { topics, label = "Chủ đề nổi bật", layout = "row", counts } = Astro.props;
---

<nav aria-label={label} class:list={["topics", layout]}>
  <ul>
    {
      topics.map((tag) => {
        const count = counts?.get(tag.id);
        return (
          <li>
            <a class="chip" href={tagUrl(tag)}>
              {tag.data.label.vi}
              {count && (
                <span class="count">
                  <span aria-hidden="true">{count}</span>
                  <span class="visually-hidden">, {count} bài</span>
                </span>
              )}
            </a>
          </li>
        );
      })
    }
    <slot />
  </ul>
</nav>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    height: var(--touch-target);
    padding: 0 var(--space-md);
    border: 1px solid var(--border-control);
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--fg);
    font-size: var(--fs-caption);
    font-weight: 500;
    text-decoration: none;
  }

  .chip:hover {
    background: var(--primary-tint);
    color: var(--fg);
  }

  .count {
    margin-left: var(--space-sm);
    color: var(--link);
    font-weight: 600;
  }

  /*
   * Trang chủ, laptop: cột chủ đề dạng danh sách chữ (RD-005). Mất viền nút
   * thì chữ trông như nhãn, nên gạch chân nhạt để thấy là link cả khi không
   * rê chuột (RD-004), giống link bằng chứng của case study.
   */
  @media (min-width: 1024px) {
    .column ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }

    .column .chip {
      padding: 0;
      border: 0;
      background: none;
      font-size: var(--fs-body);
      text-decoration: underline;
      text-decoration-color: var(--border-strong);
      text-decoration-thickness: 1px;
      text-underline-offset: 4px;
    }

    .column .chip:hover {
      background: none;
      color: var(--link);
      text-decoration-color: currentColor;
    }
  }
</style>
