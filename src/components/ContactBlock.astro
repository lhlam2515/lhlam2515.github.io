---
import { CONTACT } from "../lib/site";
import ButtonLink from "./ButtonLink.astro";

/**
 * Khối liên hệ trang chủ (IA-006), cùng kênh với footer. Laptop: chữ trái, 3
 * nút phải. Tablet: chữ trên, 3 nút một hàng. Mobile: Email toàn chiều ngang,
 * LinkedIn và GitHub chia đôi hàng dưới (RD-005).
 */
---

<section class="contact" aria-labelledby="contact-title">
  <div class="text">
    <h2 id="contact-title">Liên hệ</h2>
    <p>Email là cách nhanh nhất để trao đổi về một vị trí hay một dự án.</p>
    {/* Nút mailto: không làm gì khi máy không cài ứng dụng mail, nên địa chỉ phải chép được. */}
    <p class="address">{CONTACT.email}</p>
  </div>
  <div class="actions">
    <ButtonLink href={`mailto:${CONTACT.email}`}>Email</ButtonLink>
    <ButtonLink href={CONTACT.linkedin.url} variant="secondary">LinkedIn</ButtonLink>
    <ButtonLink href={CONTACT.github.url} variant="secondary">GitHub</ButtonLink>
  </div>
</section>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  h2 {
    font-size: var(--fs-h4);
  }

  p {
    max-width: 560px;
    line-height: 1.6;
    color: var(--fg-muted);
  }

  /* Một lần bấm chọn cả địa chỉ, không cần JS. */
  .address {
    font-family: var(--font-mono);
    font-size: var(--fs-body);
    color: var(--fg);
    overflow-wrap: anywhere;
    user-select: all;
  }

  .actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  /* Nút là grid item nên tự giãn hết ô. */
  .actions > :global(:first-child) {
    grid-column: 1 / -1;
  }

  @media (min-width: 768px) {
    .contact {
      padding: var(--space-2xl);
    }

    .actions {
      display: flex;
      gap: var(--space-md);
    }
  }

  @media (min-width: 1024px) {
    .contact {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-2xl);
    }
  }
</style>
