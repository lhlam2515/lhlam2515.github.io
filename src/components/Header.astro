---
import { NAV, SITE } from "../lib/site";

// IA-004: logo và đúng 3 mục, luôn hiện kể cả ở 320 (RD-004, không hamburger).
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container inner">
    <a class="logo" href="/" aria-label={`${SITE.name}, về trang chủ`}>
      {/* File mark lấy nguyên từ design system (assets/Logos), không vẽ lại. Bản tối
          chọn bằng prefers-color-scheme như màu của trang: gradient-primary rơi
          xuống 2.4:1 trên nền trắng nên không dùng chung một file cho hai theme. */}
      <picture>
        <source srcset="/brand/sojdev-mark-dark.svg" media="(prefers-color-scheme: dark)" />
        <img class="mark" src="/brand/sojdev-mark-light.svg" alt="" width="100" height="44" />
      </picture>
      <span class="wordmark">{SITE.name}</span>
    </a>
    <nav aria-label="Điều hướng chính">
      <ul>
        {
          NAV.map((item) => {
            const active = item.match.some((prefix) => path.startsWith(prefix));
            return (
              <li>
                <a href={item.href} aria-current={active ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  /* Link nav cao bằng header để vạch của mục đang mở nằm ngay trên viền dưới. */
  .inner {
    height: var(--header-h);
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: var(--space-md);
  }

  /* Lockup theo design system (Logo): header 72 thì mark 24, wordmark 22, cách 12.
     Các số này là kích thước riêng của lockup, không thuộc thang khoảng cách.
     Dưới 768 chỉ còn mark 20: đủ lockup (mark, wordmark 18) thì dưới ~380 đè lên
     menu, mà menu phải đủ ba mục ở 320 (RD-004). Link vẫn mang tên qua aria-label. */
  .logo {
    align-self: center;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    color: var(--fg-strong);
    text-decoration: none;
  }

  picture {
    display: contents;
  }

  .mark {
    display: block;
    width: auto;
    height: 20px;
  }

  .wordmark {
    display: none;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  ul {
    display: flex;
    gap: var(--space-xs);
    margin: 0 calc(-1 * var(--space-sm)) 0 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    height: var(--header-h);
    padding: 0 var(--space-sm);
    /* RD-003: chữ UI không dưới 16; ở 320 menu 16 vẫn vừa một dòng. */
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--fg-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--fg);
  }

  nav a[aria-current="page"] {
    font-weight: 600;
    color: var(--link);
    box-shadow: inset 0 -2px 0 var(--link);
  }

  nav a[aria-current="page"]:focus-visible {
    box-shadow: inset 0 -2px 0 var(--link), var(--focus-ring);
  }

  @media (min-width: 768px) {
    .logo {
      gap: 12px;
    }

    .mark {
      height: 24px;
    }

    .wordmark {
      display: inline;
    }

    ul {
      margin-right: calc(-1 * var(--space-md));
    }

    nav a {
      padding: 0 var(--space-md);
    }
  }
</style>
