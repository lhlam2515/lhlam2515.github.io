---
import { NAV, SITE } from "../lib/site";

// IA-004: logo và đúng 3 mục, luôn hiện kể cả ở 320 (RD-004, không hamburger).
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container inner">
    <a class="wordmark" href="/" aria-label={`${SITE.name}, về trang chủ`}>{SITE.name}</a>
    <nav aria-label="Điều hướng chính">
      <ul>
        {
          NAV.map((item) => {
            const active = item.match.some((prefix) => path.startsWith(prefix));
            return (
              <li>
                <a href={item.href} aria-current={active ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  /* Chưa có logo: wordmark Space Grotesk 700, tracking -0.02em (design system, Logo). */
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-family: var(--font-display);
    font-size: var(--fs-h5);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg-strong);
    text-decoration: none;
  }

  ul {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin: 0 calc(-1 * var(--space-sm)) 0 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    height: var(--touch-target);
    padding: 0 var(--space-sm);
    font-size: var(--fs-caption);
    font-weight: 500;
    color: var(--fg-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--fg);
  }

  nav a[aria-current="page"] {
    font-weight: 600;
    color: var(--link);
    box-shadow: inset 0 -2px 0 var(--link);
  }

  nav a[aria-current="page"]:focus-visible {
    box-shadow: inset 0 -2px 0 var(--link), var(--focus-ring);
  }

  @media (min-width: 768px) {
    ul {
      margin-right: calc(-1 * var(--space-md));
    }

    nav a {
      padding: 0 var(--space-md);
    }
  }
</style>
