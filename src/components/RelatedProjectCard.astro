---
import type { Project } from "../lib/content";
import { projectUrl } from "../lib/content";
import ImageSlot from "./ImageSlot.astro";

/**
 * Thẻ dự án liên quan trên trang bài. Xuất hiện ở nhiều độ rộng cột nên đổi
 * bố cục theo độ rộng của chính nó (RD-007): ảnh 200 cạnh chữ từ 480, ảnh
 * trên chữ dưới khi hẹp hơn.
 */
interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
---

<div class="related-card">
  <a class="related-card__body" href={projectUrl(project)}>
    {/* Ảnh desktop thu nhỏ: thẻ là thumbnail để nhận ra dự án qua bố cục, không cần đọc chữ (RD-006). */}
    <ImageSlot
      label={`Ảnh chụp ${data.title}`}
      size="2400 × 1500"
      ratio="16 / 10"
      src={data.screenshot?.light}
      darkSrc={data.screenshot?.dark}
      frame
      alt=""
      sizes="(min-width: 768px) 200px, 100vw"
    />
    <span class="text">
      <span class="title">{data.title}</span>
      <span class="summary">{data.summary}</span>
      <span class="cta">Đọc case study →</span>
    </span>
  </a>
</div>

<style>
  .related-card {
    container-type: inline-size;
  }

  .related-card__body {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-2);
    color: inherit;
    text-decoration: none;
  }

  .related-card__body:hover {
    border-color: var(--border-strong);
    color: inherit;
  }

  .related-card__body:hover :global(.slot) {
    box-shadow: var(--shot-shadow-hover);
  }

  .related-card__body:hover .title {
    color: var(--link);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--fs-h5);
    font-weight: 600;
    line-height: 1.3;
    color: var(--fg-strong);
    transition: color 120ms var(--ease);
  }

  .summary {
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .cta {
    margin-top: var(--space-xs);
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--link);
  }

  @container (min-width: 480px) {
    .related-card__body {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: var(--space-lg);
      align-items: center;
    }
  }
</style>
