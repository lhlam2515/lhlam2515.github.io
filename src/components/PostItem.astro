---
import type { Post } from "../lib/content";
import { postUrl } from "../lib/urls";
import { formatDate, isoDate } from "../lib/format";

/**
 * Một dòng trong danh sách bài (IA-005): tiêu đề, ngày, description.
 * Trang chủ đặt ngày lên trước tiêu đề (canvas Main); danh sách bài đặt sau.
 */
interface Props {
  post: Post;
  datePosition?: "before" | "after";
  /** h4 khi bài nằm dưới tiêu đề tháng (h3) của /blog/; cỡ chữ không đổi. */
  headingLevel?: "h3" | "h4";
}

const { post, datePosition = "after", headingLevel: Heading = "h3" } = Astro.props;
const { pubDate } = post.data;
---

<article class="post-item">
  {datePosition === "before" && <time class="meta" datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>}
  <Heading class="title"><a class="title-link" href={postUrl(post)}>{post.data.title}</a></Heading>
  {datePosition === "after" && <time class="meta" datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>}
  <p>{post.data.description}</p>
</article>

<style>
  .post-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .title {
    font-size: var(--fs-post-title);
  }

  p {
    max-width: 680px;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--fg-muted);
  }
</style>
