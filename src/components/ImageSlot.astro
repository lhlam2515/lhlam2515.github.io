---
/**
 * Ô ảnh, như canvas thiết kế. Chưa có ảnh: khung nét đứt, nhãn và kích thước
 * file gốc cần chuẩn bị (RD-006). Có `src`: <Picture> của astro:assets, cắt
 * bằng object-fit theo cùng tỉ lệ. Giữ tỉ lệ bằng aspect-ratio nên trang không
 * nhảy khi ảnh thật thay vào.
 */
import type { ImageMetadata } from "astro";
import { getImage, Picture } from "astro:assets";

interface Props {
  label: string;
  /** Kích thước file gốc, ví dụ "1600 × 1000". */
  size: string;
  /** Tỉ lệ khung, ví dụ "16 / 10". */
  ratio: string;
  /** Tỉ lệ dưới 768, nếu khác (chân dung 4:5 cắt 4:3 trên mobile). */
  mobileRatio?: string;
  /** Ảnh thật; bỏ trống thì hiện khung giữ chỗ. */
  src?: ImageMetadata;
  /** Bản chụp giao diện tối của `src`, hiện khi trang ở chế độ tối. */
  darkSrc?: ImageMetadata;
  /** Viền 1px: ảnh chụp giao diện nền sáng không có mép, lẫn vào nền trang. */
  frame?: boolean;
  /** Mô tả ảnh; mặc định là `label`. */
  alt?: string;
  /** object-position khi khung cắt ảnh, ví dụ "50% 20%" để giữ mặt. */
  position?: string;
  /** Ảnh ở màn hình đầu thì tải ngay. */
  loading?: "eager" | "lazy";
  /** Thuộc tính sizes cho srcset. */
  sizes?: string;
  class?: string;
}

const {
  label,
  size,
  ratio,
  mobileRatio = ratio,
  src,
  darkSrc,
  frame = false,
  alt = label,
  position = "50% 50%",
  loading = "lazy",
  sizes = "100vw",
  class: className,
} = Astro.props;

// <Picture> chỉ nhận một ảnh nguồn, nên bản có ảnh tối tự dựng <picture> bằng
// getImage(). Trình duyệt lấy <source> đầu tiên khớp media, nên bản tối đứng
// trước. Ảnh tối chọn bằng prefers-color-scheme như màu của trang, không cần
// JavaScript (ADR-004).
const FORMATS = ["avif", "webp"] as const;
// Thêm cỡ gốc để ảnh lớn hơn 1600 (ảnh đầu case study 2400) vẫn nét trên retina.
const widthsOf = (img: ImageMetadata) =>
  [...new Set([400, 800, 1200, 1600, img.width])].filter((w) => w <= img.width);
const art =
  src && darkSrc
    ? {
        sources: await Promise.all(
          [
            { img: darkSrc, media: "(prefers-color-scheme: dark)" },
            { img: src, media: undefined },
          ].flatMap(({ img, media }) =>
            FORMATS.map(async (format) => ({
              media,
              type: `image/${format}`,
              srcset: (await getImage({ src: img, format, widths: widthsOf(img) })).srcSet.attribute,
            })),
          ),
        ),
        fallback: await getImage({ src, widths: widthsOf(src) }),
      }
    : undefined;
---

{
  art && src ? (
    <div class:list={["slot", "has-image", { frame }, className]}>
      <picture>
        {art.sources.map((s) => (
          <source media={s.media} type={s.type} srcset={s.srcset} sizes={sizes} />
        ))}
        <img
          src={art.fallback.src}
          srcset={art.fallback.srcSet.attribute}
          sizes={sizes}
          width={src.width}
          height={src.height}
          alt={alt}
          loading={loading}
          decoding="async"
          fetchpriority={loading === "eager" ? "high" : undefined}
        />
      </picture>
    </div>
  ) : src ? (
    <div class:list={["slot", "has-image", { frame }, className]}>
      <Picture
        src={src}
        alt={alt}
        formats={["avif", "webp"]}
        widths={[440, 660, src.width]}
        sizes={sizes}
        loading={loading}
        fetchpriority={loading === "eager" ? "high" : undefined}
      />
    </div>
  ) : (
    <div class:list={["slot", className]} role="img" aria-label={`Chỗ đặt ${label.toLowerCase()}`}>
      <span class="label">{label}</span>
      <span class="size">{size}</span>
    </div>
  )
}

<style define:vars={{ ratio, mobileRatio, position }}>
  .slot {
    aspect-ratio: var(--mobileRatio);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-sm);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-muted);
    text-align: center;
  }

  .has-image {
    display: block;
    padding: 0;
    border: 0;
    overflow: hidden;
  }

  /* Shadow tách ảnh khỏi nền trang: ảnh chụp giao diện cùng màu nền với trang,
     chỉ có viền thì vẫn lẫn. Thẻ bọc ảnh trong link dùng `--shot-shadow-hover`
     khi hover. */
  .has-image.frame {
    --shot-shadow: var(--shadow-2);
    --shot-shadow-hover: var(--shadow-3);
    border: 1px solid var(--border);
    box-shadow: var(--shot-shadow);
    transition:
      box-shadow 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  /* Bóng đen không hiện trên nền gần đen, nên chế độ tối thêm quầng màu nhấn. */
  @media (prefers-color-scheme: dark) {
    .has-image.frame {
      --shot-shadow: var(--shadow-2), 0 0 32px var(--primary-tint);
      --shot-shadow-hover: var(--shadow-3), 0 0 48px var(--primary-tint);
      border-color: var(--border-strong);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .has-image.frame {
      transition: none;
    }
  }

  .has-image :global(picture),
  .has-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .has-image :global(img) {
    object-fit: cover;
    object-position: var(--position);
  }

  @media (min-width: 768px) {
    .slot {
      aspect-ratio: var(--ratio);
    }
  }

  .label {
    font-size: var(--fs-caption);
    font-weight: 500;
    color: var(--fg-muted);
  }

  .size {
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    color: var(--fg-subtle);
  }
</style>
